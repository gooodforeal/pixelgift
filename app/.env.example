# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pixelgift
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pixelgift

# MinIO / S3
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=pixelgift
MINIO_REGION=us-east-1

# Telegram (notifications + support; polling-бот — bot/.env)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
SUPPORT_TELEGRAM_URL=https://t.me/pixelgift_auth_bot
API_BASE_URL=http://localhost:8080/api
BOT_API_SECRET=dev-bot-api-secret

# Frontend
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# JWT
JWT_SECRET=dev-change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
LOGIN_CHALLENGE_TTL_MINUTES=10

# Public gift links in emails / MinIO console redirect
PUBLIC_WEB_URL=http://localhost:8080

# Redis / Taskiq (в docker: redis://redis:6379/0)
REDIS_URL=redis://redis:6379/0

# SMTP — в docker через Mailpit
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=PixelGift <noreply@pixelgift.local>
SMTP_USE_TLS=False

NOTIFICATION_MAX_ATTEMPTS=2
NOTIFICATION_PROCESSING_STALE_MINUTES=10

# SQLAdmin (/admin)
SQLADMIN_USERNAME=admin
SQLADMIN_PASSWORD=admin
SQLADMIN_SECRET_KEY=dev-sqladmin-session-secret
SQLADMIN_COOKIE_SECURE=false
SQLADMIN_COOKIE_SAMESITE=lax
