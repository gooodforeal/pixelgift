# Runtime env for app / taskiq_worker / taskiq_scheduler (docker network hostnames)

DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/pixelgift

# MinIO / S3
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=pixelgift
MINIO_REGION=us-east-1

# Telegram (уведомления + ссылка поддержки; polling-бот — docker/bot/.env)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
SUPPORT_TELEGRAM_URL=https://t.me/pixelgift_auth_bot

# Публичные ссылки, которые отдаются браузеру (через edge nginx)
API_BASE_URL=http://localhost:8080/api
PUBLIC_WEB_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

BOT_API_SECRET=dev-bot-api-secret

# JWT
JWT_SECRET=dev-change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
LOGIN_CHALLENGE_TTL_MINUTES=10

# Redis / Taskiq
REDIS_URL=redis://redis:6379/0

# SMTP — Mailpit (UI: http://localhost:8025)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=PixelGift <noreply@pixelgift.local>
SMTP_USE_TLS=False

NOTIFICATION_MAX_ATTEMPTS=2
NOTIFICATION_PROCESSING_STALE_MINUTES=10

# SQLAdmin (/admin) — отдельный логин, не связан с Telegram
SQLADMIN_USERNAME=admin
SQLADMIN_PASSWORD=admin
SQLADMIN_SECRET_KEY=dev-sqladmin-session-secret
SQLADMIN_COOKIE_SECURE=false
SQLADMIN_COOKIE_SAMESITE=lax

# OpenAI-compatible LLM (ассистент редактора бокса)
# Groq: https://console.groq.com — при 403 проверьте Model permissions / Limits
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
LLM_TIMEOUT_SECONDS=60
LLM_ASSISTANT_MAX_MESSAGES=20
# Опциональный HTTP(S)-прокси только для LLM (пусто = без прокси)
# Формат: http://host:port  или  http://user:password@host:port
# Спецсимволы в логине/пароле — URL-encode (например @ → %40, : → %3A)
# Из Docker к прокси на хосте: http://host.docker.internal:7890
LLM_PROXY_URL=

# YooKassa (test keys from https://yookassa.ru)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost:8080/app/profile
YOOKASSA_TIMEOUT_SECONDS=30
